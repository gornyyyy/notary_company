<Page x:Class="notary_company.Pages.GetRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заявки"
      Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Фильтры -->
        <Border Grid.Row="0" 
                Background="White" 
                CornerRadius="10" 
                Padding="15" 
                Margin="0,0,0,15"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Фильтр по статусу:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"
                           FontSize="14"/>
                <ComboBox x:Name="StatusFilterComboBox" 
                          Width="150" 
                          SelectionChanged="StatusFilterComboBox_SelectionChanged"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Все" IsSelected="True"/>
                    <ComboBoxItem Content="ожидание"/>
                    <ComboBoxItem Content="назначена дата"/>
                    <ComboBoxItem Content="выполнено"/>
                    <ComboBoxItem Content="отказано"/>
                </ComboBox>

            </StackPanel>
        </Border>

        <!-- ScrollViewer с карточками заявок -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RequestsStackPanel" Margin="0,0,0,20"/>
        </ScrollViewer>
    </Grid>
</Page>