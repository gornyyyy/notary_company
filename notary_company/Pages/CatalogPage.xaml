<Page x:Class="notary_company.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CatalogPage"
      Background="#F5F5F5"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- WrapPanel для прямоугольников с автоматическим переносом -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="ServicesWrapPanel" 
                       HorizontalAlignment="Center"
                       Margin="20,20,20,0">

                <!-- Элементы будут добавляться динамически через код -->

            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Page>