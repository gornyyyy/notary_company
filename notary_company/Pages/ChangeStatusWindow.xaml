<Window x:Class="notary_company.Pages.ChangeStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменение статуса заявки"
        Width="400"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Изменение статуса заявки" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" 
                   Text="Выберите новый статус:" 
                   FontSize="14" 
                   Margin="0,0,0,10"/>

        <ComboBox x:Name="StatusComboBox" 
                  Grid.Row="2" 
                  Height="35"
                  Margin="0,0,0,15"
                  VerticalContentAlignment="Center"
                  SelectionChanged="StatusComboBox_SelectionChanged">
            <ComboBoxItem Content="ожидание"/>
            <ComboBoxItem Content="назначена дата"/>
            <ComboBoxItem Content="выполнено"/>
            <ComboBoxItem Content="отказано"/>
        </ComboBox>

        <Border x:Name="DatePanel" 
                Grid.Row="3" 
                Visibility="Collapsed"
                Margin="0,0,0,15"
                Padding="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Выберите дату и время:" 
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <DatePicker x:Name="DatePicker" 
                           Width="200" 
                           HorizontalAlignment="Left"
                           SelectedDate="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SelectedDate}"/>
                <TextBlock Text="Время:" 
                           FontSize="14" 
                           Margin="0,10,0,5"/>
                <TextBox x:Name="TimeTextBox" 
                        Width="100" 
                        Text="10:00"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button x:Name="SaveButton"
                    Content="Сохранить"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"
                    Background="#BA6A6A"
                    Foreground="White"
                    Cursor="Hand"/>
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Width="100"
                    Height="35"
                    Click="CancelButton_Click"
                    Background="#CCCCCC"
                    Foreground="Black"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>