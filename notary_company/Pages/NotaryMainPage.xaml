<Page x:Class="notary_company.Pages.NotaryMainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="700" Width="1200"
      Title="NotaryMainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <!-- Заголовок "Нотариальная контора" -->
            <Border 
                Width="308" 
                Height="45"
                Margin="23,32,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="25"
                Background="#FFCECE"
                Cursor="Hand"
                MouseLeftButtonDown="Logo_MouseLeftButtonDown">
                <TextBlock 
                    Text="Нотариальная контора" 
                    FontSize="24" 
                    FontWeight="ExtraBold"
                    Foreground="Black"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>

            <!-- ФИО нотариуса -->
            <TextBlock 
                x:Name="NotaryNameText"
                FontSize="22"
                Foreground="Black"
                Margin="0,42,23,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FontWeight="SemiBold"/>

            <!-- Верхняя панель с кнопками -->
            <Border 
                Height="80"
                Margin="0,114,0,0"
                VerticalAlignment="Top"
                Background="#BA6A6A"
                HorizontalAlignment="Stretch">

                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="90,0,0,0">

                        <!-- Кнопка "Каталог услуг" -->
                        <Button x:Name="btnCatalog" 
                                Content="Каталог услуг"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="White"
                                Cursor="Hand"
                                HorizontalContentAlignment="Right"
                                VerticalContentAlignment="Center" 
                                Width="245"
                                Click="BtnCatalog_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5"
                                                        Padding="20,0">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#4DFFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Кнопка "Посмотреть заявки" -->
                        <Button x:Name="btnViewRequests" 
                                Content="Посмотреть заявки"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="White"
                                Cursor="Hand"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" 
                                Width="400"
                                Click="BtnViewRequests_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5"
                                                        Padding="20,0">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#4DFFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Кнопка "Добавить помощника" -->
                        <Button x:Name="btnAddAssistant" 
                                Content="Добавить помощника"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="White"
                                Cursor="Hand"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center" 
                                Width="365"
                                Click="BtnAddAssistant_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5"
                                                        Padding="20,0">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#4DFFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Frame x:Name="ContentFrame" 
           Grid.Row="1" 
           NavigationUIVisibility="Hidden"
           Margin="20"/>
    </Grid>
</Page>