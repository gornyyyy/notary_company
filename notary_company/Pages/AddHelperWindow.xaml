<Window x:Class="notary_company.Pages.AddHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:notary_company.Pages"
        mc:Ignorable="d"
        Title="Добавление помощника нотариуса" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Grid>

        <!-- Заголовок "Нотариальная контора" -->
        <Border Width="231" 
                Height="33.75" 
                Margin="23,26,0,0" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                CornerRadius="16.875" 
                Background="#FFCECE">
            <TextBlock Text="Нотариальная контора" 
                       FontSize="18" 
                       FontWeight="ExtraBold" 
                       Foreground="Black" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Заголовок окна -->
        <TextBlock Text="Добавить помощника"
                   FontSize="26"
                   FontWeight="ExtraBold"
                   Foreground="Black"
                   HorizontalAlignment="Left"
                   Margin="39,80,0,0"
                   VerticalAlignment="Top"/>

        <!-- ========== Поле ФИО ========== -->
        <TextBlock Text="ФИО помощника"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#333333"
                   Margin="39,135,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>

        <!-- Border для TextBox ФИО -->
        <Border Width="371" 
                Height="35"
                Margin="39,160,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="8"
                BorderBrush="#BA6A6A"
                BorderThickness="1"
                Background="White">
            <TextBox x:Name="HelperNameTextBox" 
                     FontSize="18"
                     VerticalContentAlignment="Center"
                     BorderThickness="0"
                     Background="White" Margin="3,2,3,2"/>
        </Border>

        <TextBlock x:Name="NameTxtStatus"
                   Text=""
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="Red"
                   Margin="39,200,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>

        <!-- ========== Поле Логин ========== -->
        <TextBlock Text="Логин"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#333333"
                   Margin="39,225,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>

        <!-- Border для TextBox Логин -->
        <Border Width="371" 
                Height="35"
                Margin="39,250,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="8"
                BorderBrush="#BA6A6A"
                BorderThickness="1"
                Background="White">
            <TextBox x:Name="HelperLoginTextBox" 
                     FontSize="18"
                     VerticalContentAlignment="Center"
                     BorderThickness="0"
                     Background="White" Margin="3,2,3,2"/>
        </Border>

        <TextBlock x:Name="LoginTxtStatus"
                   Text=""
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="Red"
                   Margin="39,290,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>

        <!-- ========== Поле Статус ========== -->
        <TextBlock Text="Статус"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#333333"
                   Margin="39,315,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>

        <Border Width="371" 
                Height="40"
                Margin="39,340,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#F0F0F0"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="8">
            <TextBlock Text="Помощник нотариуса"
                       FontSize="14"
                       Foreground="#666666"
                       VerticalAlignment="Center"
                       Padding="10,0,0,0"/>
        </Border>

        <!-- ========== Поле Описание (справа) ========== -->
        <TextBlock Text="Описание"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#333333"
                   Margin="525,135,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>

        <!-- Border для TextBox Описание -->
        <Border Width="310" 
                Height="280"
                Margin="525,160,50,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="8"
                BorderBrush="#BA6A6A"
                BorderThickness="1"
                Background="White">
            <TextBox x:Name="HelperDescriptionTextBox" 
                     FontSize="16"
                     Padding="5,5,0,0"
                     BorderThickness="0"
                     Background="White"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Margin="0,9,0,9"/>
        </Border>

        <!-- ========== Кнопка Сохранить ========== -->
        <Button x:Name="SaveButton" 
                Content="Сохранить"
                Width="200" 
                Height="45"
                Margin="350,490,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#B25B5B"
                Foreground="White"
                FontSize="16"
                FontWeight="Bold"
                BorderBrush="Transparent"
                Cursor="Hand"
                Click="SaveButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#B25B5B"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#C96D6D"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>