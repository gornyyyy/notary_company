<Window x:Class="notary_company.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нотариальная контора" 
        Width="1200" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid>
        <!-- Фоновый цвет окна -->
        <Grid.Background>
            <SolidColorBrush Color="#F5F5F5"/>
        </Grid.Background>

        <!-- Заголовок "Нотариальная контора" -->
        <Border 
            Width="308" 
            Height="45"
            Margin="23,32,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            CornerRadius="10"
            Background="#2C3E50">
            <TextBlock 
                Text="Нотариальная контора" 
                FontSize="16" 
                FontWeight="Bold"
                Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

        <!-- Ссылка "Войти как нотариус" -->
        <TextBlock 
            Text="Войти как нотариус"
            FontSize="12"
            Foreground="#2980B9"
            Cursor="Hand"
            Margin="0,42,23,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            TextDecorations="Underline">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#2980B9"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#1abc9c"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Верхняя панель с кнопками -->
        <Border 
            Width="1200" 
            Height="80"
            Margin="0,114,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#34495E">

            <Grid>
                <!-- Контейнер для равномерного распределения кнопок -->
                <StackPanel 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <!-- Кнопка "Каталог услуг" -->
                    <Button x:Name="btnCatalog" 
                            Content="Каталог услуг"
                            Width="180"
                            Height="40"
                            Margin="20,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1abc9c"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Кнопка "Подать заявку" -->
                    <Button x:Name="btnCreateRequest" 
                            Content="Подать заявку"
                            Width="180"
                            Height="40"
                            Margin="20,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#27AE60"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#229954"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1E8449"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Кнопка "Посмотреть мои заявки" -->
                    <Button x:Name="btnMyRequests" 
                            Content="Посмотреть мои заявки"
                            Width="180"
                            Height="40"
                            Margin="20,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#8E44AD"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#7D3C98"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#6C3483"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент (будет меняться при навигации) -->
        <Frame x:Name="MainFrame" 
               Margin="0,194,0,0"
               NavigationUIVisibility="Hidden"/>

        <!-- Нижняя панель статуса -->
        <StatusBar Grid.Row="1" VerticalAlignment="Bottom" Height="25">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>