<Window x:Class="notary_company.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нотариальная контора" 
        Width="1200" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid>
        <!-- Фоновый цвет окна -->
        <Grid.Background>
            <SolidColorBrush Color="#F5F5F5"/>
        </Grid.Background>

        <!-- Заголовок "Нотариальная контора" -->
        <Border 
            Width="308" 
            Height="45"
            Margin="23,32,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            CornerRadius="25"
            Background="#FFCECE">
            <TextBlock 
                Text="Нотариальная контора" 
                FontSize="24" 
                FontWeight="ExtraBold"
                Foreground="Black"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>

        <!-- Надпись "Войти как нотариус" или имя нотариуса -->
        <TextBlock 
            x:Name="NotaryLoginText"
            Text="Войти как нотариус"
            FontSize="22"
            Foreground="Black"
            Cursor="Hand"
            Margin="0,42,23,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            TextDecorations="Underline"
            MouseLeftButtonDown="NotaryLoginText_MouseLeftButtonDown">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#2980B9"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#1abc9c"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Верхняя панель с кнопками -->
        <Border 
            Height="80"
            Margin="0,114,0,0"
            VerticalAlignment="Top"
            Background="#BA6A6A">

            <Grid>
                <!-- Контейнер для кнопок -->
                <StackPanel Orientation="Horizontal" Margin="90,0,0,0">

                    <!-- Кнопка "Каталог услуг" -->
                    <Button x:Name="btnCatalog" 
                            Content="Каталог услуг"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand"
                            HorizontalContentAlignment="Right"
                            VerticalContentAlignment="Center" 
                            Width="245">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="20,0">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#4DFFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Кнопка "Подать заявку" -->
                    <Button x:Name="btnCreateRequest" 
                            Content="Подать заявку"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" 
                            Width="400">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="20,0">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#4DFFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Кнопка "Посмотреть мои заявки" -->
                    <Button x:Name="btnMyRequests" 
                            Content="Посмотреть мои заявки"
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center" 
                            Width="394">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="20,0">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#4DFFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>